"4	LINE	0
	
	read n 
	read m
	
	m=`expr $m - 1`
	
	fact[0]=1
	
	get() {
	    #echo "aaaa"
	    cnt=0
	    for((i = 1; i <= n; i++)) do
	        if [ ${st[$i]} -eq 0 ]
	        then
	            if [ $cnt -eq $1 ]
	            then
	                st[$i]=1
	                echo $i
	                return 0
	            fi
	            cnt=`expr $cnt + 1`
	        fi
	    done
	}
	
	#echo ${fact[1]}
	
	for((i = 1; i <= n; i++)) do
	    st[$i]=0
	    x=`expr $i - 1`
	    fact[$i]=$(expr ${fact[$x]} \* $i)
	    echo ${fact[$i]}
	done
	
	for((i = 1; i <= n; i++)) do
	    p=$(expr $m / ${fact[`expr $n - $i`]} )
	    q=$(expr $m % ${fact[$(expr $n - $i)]} )
	    printf "%d %d\n" $p $q
	    printf "%d\n" `get $p`
	    for((j = 1 ; j <= n; j++)) do
	        printf "%d " ${st[$j]}
	    done
	    echo ""
	    m=$q
	done
